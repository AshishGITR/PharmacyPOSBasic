@page
@model IndexModel

<h2>Medical Shop Billing</h2>

<div>
    Customer Name:
    <input id="customer" />

    Doctor Name:
    <input id="doctor" />
</div>

<hr />

<h3>Medicines</h3>
<select id="medicineList" onchange="loadBatches()"></select>

<select id="batchList"></select>

<input type="number" id="qty" placeholder="Quantity" />
<button onclick="addToCart()">Add</button>

<hr />

<h3>Cart</h3>
<ul id="cart"></ul>

<h3>Total: ₹ <span id="total">0</span></h3>

<button onclick="checkout()">Checkout</button>

<script>
    let cart = [];

    async function loadMedicines() {
        let res = await fetch('https://localhost:7187/api/Medicines');
        let data = await res.json();

        let dropdown = document.getElementById("medicineList");
        data.forEach(m => {
            dropdown.innerHTML += `<option value="${m.id}">${m.name}</option>`;
        });
    }

    async function loadBatches() {
        let medId = document.getElementById("medicineList").value;
        let res = await fetch(`https://localhost:7187/api/medicines/batches/${medId}`);
        let data = await res.json();

        let batchList = document.getElementById("batchList");
        batchList.innerHTML = "";

        data.forEach(b => {
            batchList.innerHTML += `<option value="${b.id}">${b.batchNumber} - ₹${b.price}</option>`;
        });
    }

    function addToCart() {
        let MedicineName = document.getElementById("medicineList").innerHTML;
        let batchId = document.getElementById("batchList").value;
        let qty = document.getElementById("qty").value;

        cart.push({ MedicineName: MedicineName,Batch:batchId, quantity: parseInt(qty) });

        renderCart();
    }

    function renderCart() {
        let list = document.getElementById("cart");
        list.innerHTML = "";
        cart.forEach(c => {
            console.log(c);
            list.innerHTML += `<li>Batch: ${c.batchNumber} Qty: ${c.quantity}</li>`;
        });
    }

    async function checkout() {
        let data = {
            customerName: document.getElementById("customer").value,
            doctorName: document.getElementById("doctor").value,
            items: cart
        };

        let res = await fetch('https://localhost:7187/api/Sales', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (res.ok) {
            alert("Sale Completed!");
            cart = [];
            renderCart();
        } else {
            alert(await res.text());
        }
    }

    loadMedicines();
</script>